<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Marea calls and video calls: macOS asks for permission with these texts -->
  <key>NSCameraUsageDescription</key>
  <string>Marea uses the camera for video calls.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Marea uses the microphone for calls, voice messages and dictation.</string>
  <!-- Dictation in Marea (the microphone of the command bar) uses WebKit's speech recognition, which refuses with
       "service-not-allowed" unless the app declares this (0.4.1) -->
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Marea uses speech recognition to turn what you dictate into text, for example in the command bar.</string>
  <!-- Your location, only when Marea asks (the weather): see src/location.rs -->
  <key>NSLocationUsageDescription</key>
  <string>Marea uses your location only when you ask it to, for example to show your local weather.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Marea uses your location only when you ask it to, for example to show your local weather.</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>es</string>
    <string>fr</string>
    <string>ca</string>
  </array>
  <key>NSHumanReadableCopyright</key>
  <string>© 2026 Paperclip · AGPL-3.0</string>
</dict>
</plist>
