{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marea",
  "version": "0.2.1",
  "identifier": "es.paperclip.marea",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Productivity",
    "shortDescription": "Marea on your desktop",
    "longDescription": "The desktop app for Marea: your waves, mail and calendar in their own window, with system notifications and the pending count on the icon. It connects to the Marea you choose.",
    "copyright": "© 2026 Paperclip",
    "publisher": "Paperclip",
    "homepage": "https://github.com/mareabypaperclip/marea-desktop",
    "license": "AGPL-3.0-or-later",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 640,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 460,
          "y": 190
        }
      },
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "./macos/es.lproj/InfoPlist.strings",
        "Resources/fr.lproj/InfoPlist.strings": "./macos/fr.lproj/InfoPlist.strings",
        "Resources/ca.lproj/InfoPlist.strings": "./macos/ca.lproj/InfoPlist.strings"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish",
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "section": "net"
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
